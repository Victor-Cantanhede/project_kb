# Porta HTTP da API. Caso a porta 3000 esteja em uso localmente, altere para PORT=3001.
PORT=3000
# Host de escuta. 127.0.0.1 evita colisão com localhost IPv6 (::1) no Windows. Em Docker, use 0.0.0.0.
HOST=127.0.0.1
INSTANCE_ID=api-local
DATABASE_URL=mysql://hero:hero@127.0.0.1:3307/hero_factory
DATABASE_URL_TEST=mysql://hero:hero@127.0.0.1:3307/hero_factory_test

